# Copy this file to .env and fill in real values. .env is gitignored - never commit it.

# --- Server ---
PORT=4000
HOST=127.0.0.1
TZ_NAME=Europe/Amsterdam

# --- Database (MariaDB 11.8) ---
# mysql://user:password@host:port/database
DATABASE_URL=mysql://snowman:snowman@127.0.0.1:3306/snowman

# --- Olaf (Claude API) ---
# Leave unset to run with Olaf disabled (brain.available=false, routes return 503).
ANTHROPIC_API_KEY=
# Only needed if your API key is not scoped to a workspace (Console > Settings > Workspaces, ID starts with wrkspc_).
ANTHROPIC_WORKSPACE_ID=
OLAF_MODEL_FAST=claude-haiku-4-5
OLAF_MODEL_SMART=claude-sonnet-5
AI_MONTHLY_BUDGET_USD=15

# Path to Olaf's persona file. Defaults to data/persona.md if unset, falling
# back to config/persona.example.md when that file does not exist yet.
PERSONA_FILE=

# --- CORS (local web testing only) ---
# Comma-separated list of allowed origins for the Expo web dev server.
CORS_ORIGINS=http://localhost:8081

# --- Test only ---
# Set to a MariaDB connection string to run DB integration tests.
# Left unset, those tests are skipped.
TEST_DATABASE_URL=
